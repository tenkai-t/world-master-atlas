riptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=82203821","extmetadata":{"DateTime":{"value":"2019-09-15 20:42:33","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Head Smashed-In Buffalo Jump (38469486544)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Photographs by David Stanley|Files with coordinates missing SDC location of creation|Flickr images reviewed by FlickreviewR 2|Head-Smashed-In Buffalo Jump|July 2017 in Alberta","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"49.707543","source":"commons-desc-page"},"GPSLongitude":{"value":"-113.653081","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"For over 6,000 years Plains Indian hunters stampeded buffalo over the Head Smashed-In Buffalo Jump near Fort MacLeod, Alberta, Canada. The animals were then butchered at a camp below the cliffs.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2017-07-18 11:33","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"mw:ExtLink nofollow\" href=\"https://www.flickr.com/photos/davidstanleytravel/38469486544/\" class=\"external text\">Head Smashed-In Buffalo Jump</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"mw:ExtLink nofollow\" href=\"https://www.flickr.com/people/79721788@N00\" class=\"external text\">David Stanley</a> from Nanaimo, Canada","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}}}]},"74749948":{"pageid":74749948,"ns":6,"title":"File:Head Smashed In Buffalo Jump (15194897111).jpg","index":4,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Head_Smashed_In_Buffalo_Jump_%2815194897111%29.jpg/960px-Head_Smashed_In_Buffalo_Jump_%2815194897111%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":800,"thumbheight":533,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/1/12/Head_Smashed_In_Buffalo_Jump_%2815194897111%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Head_Smashed_In_Buffalo_Jump_%2815194897111%29.jpg/960px-Head_Smashed_In_Buffalo_Jump_%2815194897111%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":800,"height":533,"srcset":"https://upload.wikimedia.org/wikipedia/commons/1/12/Head_Smashed_In_Buffalo_Jump_%2815194897111%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/12/Head_Smashed_In_Buffalo_Jump_%2815194897111%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Head_Smashed_In_Buffalo_Jump_(15194897111).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=74749948","extmetadata":{"DateTime":{"value":"2018-11-29 16:31:42","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Head Smashed In Buffalo Jump (15194897111)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Files with coordinates missing SDC location of creation|Canada photographs taken on 2014-09-09|Flickr images reviewed by FlickreviewR 2|Head-Smashed-In Buffalo Jump|Photographs by Wilson Hui","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"49.705578","source":"commons-desc-page"},"GPSLongitude":{"value":"-113.653285","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Head Smashed In Buffalo Jump is a UNESCO World Heritage Site where natives drove entire herds of buffalo off a cliff and slaughtered them for meat and fur. This one differs from the many other buffalo jumps in the province due to its age, size and level of preservation.</p>\n\n<p>The buffalo herds move around a lot and when a buffalo jump is utilized, the entire herd is wiped out, so there are actually many buffalo jumps on the Alberta prairies, not just this one. It'd be ridiculous to try and drive buffalo from Calgary down to Fort Macleod. Dry Island buffalo jump is another favorite of mine that's located in the Alberta Badlands.</p>\n\nHead Smashed In Buffalo Jump was the first stop on our tour of historic Alberta and where I purchased the annual pass. I met pita iguan here and had some interesting conversations about the history of the peoples that live here. Thanks!","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on<span typeof=\"mw:Entity\">\u00a0</span>9 September 2014, 07:37<link rel=\"mw:PageProp/Category\" href=\"./Category:Canada_photographs_taken_on_2014-09-09\">","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"mw:ExtLink nofollow\" href=\"https://www.flickr.com/photos/wilsonhui/15194897111/\" class=\"external text\">Head Smashed In Buffalo Jump</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"mw:ExtLink nofollow\" href=\"https://www.flickr.com/people/51942038@N04\" class=\"external text\">Wilson Hui</a> from Calgary, Canada","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}}}]}}}}